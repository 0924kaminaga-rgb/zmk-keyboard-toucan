#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        adj_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
                &kp TAB               &kp Q                 &kp W                 &kp E                 &kp R                 &kp T                 &kp Y                 &kp U                 &kp I                 &kp O                 &kp P                 &kp BSPC              
                &kp LCTRL             &kp A                 &kp S                 &kp D                 &kp F                 &kp G                 &kp H                 &kp J                 &kp K                 &kp L                 &kp LS(FSLH)          &kp MINUS             
                &kp LSHFT             &kp Z                 &kp X                 &kp C                 &kp V                 &kp B                 &kp N                 &kp M                 &kp COMMA             &kp DOT               &kp FSLH              &kp RSHFT             
                                            &kp LANG2             &mo 1                 &kp SPACE             &kp RET               &mo 2                 &kp LANG1             
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
                &kp TAB               &kp N1                &kp N2                &kp N3                &kp N4                &kp INT1              &kp N7                &kp N8                &kp N9                &kp LS(SEMI)          &kp MINUS             &kp BSPC              
                &bt BT_CLR            &bt BT_SEL 0          &bt BT_SEL 1          &bt BT_SEL 2          &bt BT_SEL 3          &bt BT_SEL 4          &kp N4                &kp N5                &kp N6                &kp KP_MULTIPLY       &kp FSLH              &kp DOT               
                &kp LSHFT             &studio_unlock        &kp N0                &trans                &mkp MB1              &mkp MB2              &kp N1                &kp N2                &kp N3                &kp N0                &kp LS(MINUS)         &kp RET               
                                            &kp LGUI              &trans                &kp SPACE             &kp RET               &trans                &kp RALT              
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
                &kp TAB               &kp LS(N0)            &kp LS(N2)            &kp LS(N3)            &kp LS(N4)            &kp LS(N5)            &kp LS(N6)            &kp LS(N7)            &kp LS(N8)            &kp LS(N9)            &kp LS(N1)            &kp LBKT              
                &kp LCTRL             &kp PSCRN             &kp LC(C)             &kp LC(V)             &trans                &trans                &kp MINUS             &kp LS(N5)            &kp UP                &kp LS(MINUS)         &kp RBKT              &kp BSLH              
                &kp LSHFT             &trans                &kp N1                &trans                &trans                &trans                &kp LS(MINUS)         &kp LEFT              &kp DOWN              &kp RIGHT             &kp LS(LBKT)          &kp LS(RBKT)          
                                            &kp LGUI              &trans                &kp SPACE             &kp RET               &trans                &kp RALT              
            >;
        };

        adj_layer {
            display-name = "ADJ";
            bindings = <
                &kp TAB               &trans                &kp F7                &kp F8                &kp F9                &kp F12               &kp C_VOL_DN          &kp C_MUTE            &kp C_VOL_UP          &trans                &trans                &kp BSPC              
                &kp LCTRL             &trans                &kp F4                &kp F5                &kp F6                &kp F11               &trans                &trans                &trans                &trans                &trans                &trans                
                &kp LSHFT             &trans                &kp F1                &kp F2                &kp F3                &kp F10               &trans                &trans                &trans                &trans                &trans                &trans                
                                            &kp LGUI              &mo 1                 &kp SPACE             &kp RET               &mo 2                 &kp RALT              
            >;
        };
    };
};
